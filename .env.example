PRIVATE_KEY=0x...
MUMBAI_RPC=https://polygon-mumbai.g.alchemy.com/v2/...
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/...
ROUTER_ADDRESS=0xYOUR_QUICKSWAP_ROUTER
WMATIC_ADDRESS=0xYOUR_WMATIC
USDT_ADDRESS=0xYOUR_USDT
PORK_ADDRESS=                       # filled after deploy or used for scripts

# Amoy deploy (scripts/deploy-amoy.ts) — TESTNET-ONLY wallet, never mainnet:
# DEPLOYER_PRIVATE_KEY=0x...
# POLYGONSCAN_API_KEY=<your key>          # AmoyScan contract verification (free at polygonscan.com)
# AMOY_RPC=https://api.zan.top/polygon-amoy   # override the default RPC if needed
# --- REQUIRED by deploy-amoy.ts (the script aborts if these are missing/wrong) ---
# PRESALE_START=<future unix timestamp>   # e.g. $(date -d "2026-10-20 10:00:00" +%s)
# PRESALE_DAYS=30
# PORK_PER_USDC=66666.67                  # PORK tokens per 1 USDC — must be >> 1 (aborts if < 1)
# Optional: real Amoy USDC + DEX router (defaults: mock USDC, zero router)
# USDC_AMOY=0x...
# ROUTER_AMOY=0x...

# Team wallets (used by scripts/deploy-amoy.ts; defaults are Erik's provided addresses)
